[gd_resource type="Resource" script_class="PassiveItemData" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/data/passive_item_data.gd" id="1_passive"]

[resource]
script = ExtResource("1_passive")
id = &"cloud_seed"
display_name = "Cloud Seed"
description = "Common size passive. Every 5th eligible cast gets an extra size bloom at level 5."
tags = Array[StringName]([&"prototype"])
draft_rarity = &"common"
catalyst_tags = Array[StringName]([&"bloom", &"wonder"])
